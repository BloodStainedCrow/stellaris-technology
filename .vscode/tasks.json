{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "rebuild grammar",
            "type": "shell",
            "command": "antlr4 -Dlanguage=Java -o src/main/java/net/turanar/stellaris/antlr Stellaris.g4 -package net.turanar.stellaris.antlr -visitor -listener",
            "problemMatcher": []
        },
        {
            "label": "run",
            "type": "shell",
            "command": "mvn org.springframework.boot:spring-boot-maven-plugin:2.1.4.RELEASE:run -e",
            "problemMatcher": []
        },
        {
            "label": "remove empty files",
            "type": "shell",
            "command": "./delete_empty_files.sh files/common",
            "problemMatcher": []
        },
        {
            "label": "fix yml",
            "type": "shell",
            "command": "./fix_yml.sh && ./fix_newline_in_yml.sh",
            "problemMatcher": []
        }
    ]
}